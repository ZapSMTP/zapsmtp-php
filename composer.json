{
    "name": "zapsmtp/zapsmtp-php",
    "description": "The official PHP SDK for the ZapSMTP email API",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "smtp", "transactional email", "zapsmtp", "api", "sdk"],
    "homepage": "https://zapsmtp.com/docs/sdks/",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "guzzlehttp/psr7": "^2.4 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "ZapSMTP\\Model\\": "src/Generated/Model/",
            "ZapSMTP\\Service\\": "src/Generated/Service/",
            "ZapSMTP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZapSMTP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "phpunit --coverage-text --coverage-clover=coverage/clover.xml",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
